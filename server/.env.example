# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Development: the pace_dev database on the Railway MySQL server, via its public TCP proxy.
# mysql://root:<MYSQL_ROOT_PASSWORD>@<proxy-host>:<proxy-port>/pace_dev
# Tests use pace_test on the same server (or TEST_DATABASE_URL if set).
DATABASE_URL=

# Address of the app in the browser; used in links inside emails.
APP_URL=http://localhost:5173

# Object storage (Railway bucket pace-uploads): `railway bucket credentials --bucket pace-uploads`
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Keeps development files apart from production files in the same bucket.
STORAGE_PREFIX=dev/

# Email. Leave SMTP_* empty in development: reset links are then printed in the server log.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<address>, SMTP_PASSWORD=<app password>
MAIL_FROM=PACE <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
