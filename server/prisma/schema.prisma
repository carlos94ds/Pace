// PACE database schema. This file is the single source of truth:
// change tables here and create a migration, never in MySQL Workbench.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- Enums ----------

enum TrainingLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  COMPETITIVE
  PROFESSIONAL
}

enum Visibility {
  PRIVATE
  FRIENDS
}

enum Language {
  NL
  EN
  DE
  FR
  PT
  IT
  ES
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum TextSize {
  SMALL
  MEDIUM
  LARGE
}

enum Punctuality {
  ON_TIME
  LATE
}

enum GoalType {
  TOTAL_MINUTES
  TRAINING_DAYS
  PUNCTUALITY_PCT
  SPORT_SESSIONS
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ReactionTarget {
  SESSION
  ACHIEVEMENT
  STREAK
  WEEKLY_GOAL
}

enum ReactionType {
  RESPECT
  WELL_DONE
  KEEP_GOING
}

enum AchievementCategory {
  STREAK
  VOLUME
  GOAL
  MILESTONE
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FRIEND_ACHIEVEMENT
  REACTION
  WEEKLY_REPORT
  STREAK_MILESTONE
  GOAL_ACHIEVED
}

// ---------- Accounts ----------

model User {
  id              String    @id @default(uuid()) @db.Char(36)
  email           String    @unique @db.VarChar(191)
  passwordHash    String    @db.VarChar(255)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile           UserProfile?
  privacy           PrivacySettings?
  preferences       UserPreferences?
  authSessions      AuthSession[]
  resetTokens       PasswordResetToken[]
  sports            UserSport[]
  gyms              UserGym[]
  customSports      Sport[]              @relation("CustomSports")
  gymsCreated       Gym[]                @relation("GymCreator")
  sessions          TrainingSession[]
  goals             WeeklyGoal[]
  reports           WeeklyReport[]
  weights           WeightMeasurement[]
  achievements      UserAchievement[]
  notifications     Notification[]       @relation("NotificationRecipient")
  sentRequests      Friendship[]         @relation("Requester")
  receivedRequests  Friendship[]         @relation("Addressee")
  reactionsGiven    Reaction[]           @relation("ReactionFrom")
  reactionsReceived Reaction[]           @relation("ReactionTo")
}

// "Current weight" is not stored here: it is the latest WeightMeasurement.
model UserProfile {
  userId        String        @id @db.Char(36)
  username      String        @unique @db.VarChar(30)
  firstName     String        @db.VarChar(60)
  bio           String?       @db.VarChar(280)
  avatarKey     String?       @db.VarChar(255)
  heightCm      Int?          @db.SmallInt
  trainingLevel TrainingLevel @default(BEGINNER)
  personalGoals String?       @db.Text
  timezone      String        @default("Europe/Amsterdam") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([firstName])
}

model AuthSession {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @db.Char(36)
  tokenHash  String   @unique @db.Char(64)
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PrivacySettings {
  userId                 String     @id @db.Char(36)
  // Search and suggestions only ever show username, first name and avatar.
  discoverable           Boolean    @default(true)
  profileVisibility      Visibility @default(FRIENDS)
  activityVisibility     Visibility @default(FRIENDS)
  streaksVisibility      Visibility @default(FRIENDS)
  achievementsVisibility Visibility @default(FRIENDS)
  dashboardVisibility    Visibility @default(PRIVATE)
  weightVisibility       Visibility @default(PRIVATE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreferences {
  userId                 String   @id @db.Char(36)
  language               Language @default(EN)
  theme                  Theme    @default(SYSTEM)
  textSize               TextSize @default(MEDIUM)
  notifyFriendRequests   Boolean  @default(true)
  notifyFriendAccepted   Boolean  @default(true)
  notifyFriendMilestones Boolean  @default(true)
  notifyReactions        Boolean  @default(true)
  notifyWeeklyReport     Boolean  @default(true)
  notifyStreaks          Boolean  @default(true)
  notifyGoals            Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Training ----------

// Built-in sports have ownerId NULL and a slug used for translation;
// custom sports belong to one user and are shown by name.
model Sport {
  id      String  @id @default(uuid()) @db.Char(36)
  slug    String? @unique @db.VarChar(40)
  name    String  @db.VarChar(50)
  color   String  @db.Char(7)
  ownerId String? @db.Char(36)

  owner    User?             @relation("CustomSports", fields: [ownerId], references: [id], onDelete: Cascade)
  sessions TrainingSession[]
  users    UserSport[]
  goals    WeeklyGoal[]

  @@unique([ownerId, name])
}

model UserSport {
  userId  String @db.Char(36)
  sportId String @db.Char(36)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([userId, sportId])
  @@index([sportId])
}

/// Gyms a user trains at. `position` keeps the user's order; the first is the default for new sessions.
model UserGym {
  userId   String @db.Char(36)
  gymId    String @db.Char(36)
  position Int    @db.TinyInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([userId, gymId])
  @@index([gymId])
}

model Gym {
  id          String  @id @default(uuid()) @db.Char(36)
  name        String  @db.VarChar(100)
  city        String  @db.VarChar(100)
  createdById String? @db.Char(36)

  createdBy User?             @relation("GymCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   UserGym[]
  sessions  TrainingSession[]

  @@unique([name, city])
  @@index([createdById])
}

model TrainingSession {
  id              String      @id @default(uuid()) @db.Char(36)
  userId          String      @db.Char(36)
  sportId         String      @db.Char(36)
  gymId           String?     @db.Char(36)
  date            DateTime    @db.Date
  durationMinutes Int         @db.SmallInt // CHECK 1..1440
  punctuality     Punctuality
  motivation      Int?        @db.TinyInt // before training, CHECK 1..5; no longer asked
  rating          Int         @db.TinyInt // how it went, CHECK 1..5
  intensity       Int?        @db.TinyInt // CHECK 1..5; no longer asked
  energy          Int?        @db.TinyInt // energy level, CHECK 1..5; null on older sessions
  injured         Boolean     @default(false)
  injuryNote      String?     @db.VarChar(500) // where it hurts; private, never shared
  injuryCause     String?     @db.VarChar(500) // why the user thinks it happened; private
  ratingReason    String?     @db.VarChar(500) // why the training went well or badly; private
  energyReason    String?     @db.VarChar(500) // why energy was high or low; private
  reflection      String?     @db.Text // private unless shareDetails
  shareDetails    Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Restrict)
  gym   Gym?  @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([sportId])
  @@index([gymId])
}

// ---------- Goals & reports ----------

model WeeklyGoal {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @db.Char(36)
  type       GoalType
  target     Int
  sportId    String?   @db.Char(36) // required when type = SPORT_SESSIONS
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport Sport? @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@index([sportId])
}

// Stores a snapshot so old reports don't change when sessions or goals are edited.
model WeeklyReport {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @db.Char(36)
  weekStart   DateTime  @db.Date
  timezone    String    @db.VarChar(64)
  stats       Json
  goalResults Json
  comparison  Json
  highlights  Json
  conclusion  Json // [{ key, params }], translated in the client
  generatedAt DateTime  @default(now())
  viewedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

// ---------- Social ----------

model Friendship {
  id          String           @id @default(uuid()) @db.Char(36)
  requesterId String           @db.Char(36)
  addresseeId String           @db.Char(36)
  // "<smallerId>:<largerId>", so A→B and B→A can't both exist.
  pairKey     String           @unique @db.Char(73)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model Reaction {
  id         String         @id @default(uuid()) @db.Char(36)
  fromUserId String         @db.Char(36)
  toUserId   String         @db.Char(36)
  targetType ReactionTarget
  targetId   String         @db.VarChar(64)
  type       ReactionType
  createdAt  DateTime       @default(now())

  fromUser User @relation("ReactionFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ReactionTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, targetType, targetId, type])
  @@index([toUserId, createdAt])
}

model Achievement {
  id         String              @id @default(uuid()) @db.Char(36)
  code       String              @unique @db.VarChar(50)
  category   AchievementCategory
  threshold  Int
  repeatable Boolean             @default(false)

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Char(36)
  userId        String   @db.Char(36)
  achievementId String   @db.Char(36)
  periodKey     String   @default("") @db.VarChar(10) // "" or e.g. "2026-W45" for repeatables
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId, periodKey])
  @@index([achievementId])
}

model Notification {
  id        String           @id @default(uuid()) @db.Char(36)
  userId    String           @db.Char(36)
  type      NotificationType
  actorId   String?          @db.Char(36)
  payload   Json // { key, params, link }
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

// ---------- Weight ----------

model WeightMeasurement {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @db.Char(36)
  weightKg   Decimal  @db.Decimal(5, 2)
  measuredAt DateTime
  note       String?  @db.VarChar(280)
  createdAt  DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence WeightEvidence?

  @@index([userId, measuredAt])
}

model WeightEvidence {
  id            String   @id @default(uuid()) @db.Char(36)
  measurementId String   @unique @db.Char(36)
  storageKey    String   @db.VarChar(255)
  mimeType      String   @db.VarChar(50)
  sizeBytes     Int
  sha256        String   @db.Char(64)
  uploadedAt    DateTime @default(now())

  measurement WeightMeasurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)
}

// ---------- Housekeeping ----------

// Files to remove from object storage. Written in the same transaction as the database change
// (e.g. account deletion), so a failed storage call is retried instead of leaving orphaned photos.
model PendingFileDeletion {
  id        String   @id @default(uuid()) @db.Char(36)
  key       String   @db.VarChar(255)
  attempts  Int      @default(0)
  lastError String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
